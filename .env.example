# 测试环境配置示例
# 复制此文件为 .env 并填入你的实际配置

# ==================== 基础配置 ====================
LEVEL=lossless
MODE=api
URL=http://127.0.0.1:5000

# ==================== 定时同步配置 ====================

# 是否启用定时同步 (true/false)
ENABLE_SYNC=true

# 需要同步的歌单ID列表（多个用逗号分隔）
# ⚠️ 请替换为你的实际歌单ID
# 获取方法：打开网易云音乐网页版 -> 进入歌单 -> 从URL中复制id参数
# 例如: https://music.163.com/#/playlist?id=1234567890
PLAYLIST_IDS=699860239

# 同步音质 (standard/exhigh/lossless/hires/sky/jyeffect/jymaster)
SYNC_QUALITY=lossless

# 同步间隔（秒），默认3600秒（1小时）
# 测试时建议设置为较短时间，如60秒
SYNC_INTERVAL=60

# Cron表达式（可选，如果设置则优先于SYNC_INTERVAL）
# 测试时可以注释掉，使用SYNC_INTERVAL
# CRON_EXPRESSION=

# 下载目录（本地测试时使用相对路径）
DOWNLOADS_DIR=downloads
